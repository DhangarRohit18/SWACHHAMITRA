<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:background="@color/background"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@color/white"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleEnabled="false">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDetailIssue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                tools:src="@tools:sample/backgrounds/scenic" />

            <View
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_gradient_scrim" />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbarDetail"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="@android:drawable/ic_menu_revert"
                app:navigationIconTint="@color/white"
                android:background="@android:color/transparent" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet_top_corners"
        android:backgroundTint="@color/white"
        android:layout_marginTop="-32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDetailCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CivSetu.Label"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:background="@color/primaryContainer"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        tools:text="Roads &amp; Transport" />

                    <TextView
                        android:id="@+id/tvDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                        android:textStyle="bold"
                        android:textColor="@color/onSurface"
                        android:letterSpacing="-0.01"
                        tools:text="Major pothole fix needed on 5th Ave" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="16dp">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnUpvote"
                        style="@style/Widget.CivSetu.Card"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/surfaceVariant"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/arrow_up_float"
                            app:tint="@color/primary"/>
                    </com.google.android.material.card.MaterialCardView>
                    <TextView
                        android:id="@+id/tvUpvoteCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textStyle="bold"
                        android:textColor="@color/primary"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="28dp"
                android:gravity="center_vertical">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDetailStatus"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    app:chipCornerRadius="18dp"
                    app:chipStrokeWidth="0dp"
                    app:chipBackgroundColor="@color/secondaryContainer"
                    android:textColor="@color/onSecondaryContainer"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    tools:text="In Progress" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDetailPriority"
                    style="@style/Widget.Material3.Chip.Suggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    app:chipCornerRadius="18dp"
                    app:chipStrokeWidth="0dp"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    tools:text="CRITICAL" 
                    app:chipBackgroundColor="@color/errorContainer"
                    android:textColor="@color/onErrorContainer"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSLA"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    app:chipCornerRadius="18dp"
                    app:chipStrokeWidth="0dp"
                    android:textColor="@color/white"
                    tools:text="SLA: 2D REMAINING" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/onSurfaceVariant"
                android:lineSpacingExtra="8dp"
                android:alpha="0.9"
                tools:text="Detailed description of the issue goes here. This area describes the problem in detail for official action. Multiple lines of text should look clean and readable." />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/voiceCard"
                style="@style/Widget.CivSetu.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surfaceVariant"
                android:visibility="gone"
                tools:visibility="visible">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnPlayVoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:fabSize="mini"
                        app:srcCompat="@android:drawable/ic_media_play"
                        app:backgroundTint="@color/primary"
                        app:tint="@color/white"
                        app:elevation="4dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="@string/listen_voice"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"/>
                    <ProgressBar
                        android:id="@+id/voicePlaybackProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:progress="30"
                        android:max="100"
                        android:progressTint="@color/primary"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/aiInsightCard"
                style="@style/Widget.CivSetu.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/secondary"
                android:visibility="gone"
                tools:visibility="visible">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="#080891B2">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_insight"
                        android:textAppearance="@style/TextAppearance.CivSetu.Label"
                        android:textColor="@color/secondary"
                        android:textSize="11sp"
                        app:drawableStartCompat="@android:drawable/btn_star"
                        app:drawableTint="@color/secondary"
                        android:drawablePadding="12dp"
                        android:layout_marginBottom="12dp"/>
                    <TextView
                        android:id="@+id/tvAiReasoning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:lineSpacingExtra="4dp"
                        tools:text="AI has identified this as a high risk due to proximity to the main highway and significant traffic disruption potential."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outlineVariant"
                android:layout_marginVertical="36dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/actionable_location"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textStyle="bold" 
                android:textColor="@color/onSurface"/>

            <TextView
                android:id="@+id/tvDetailAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                app:drawableStartCompat="@android:drawable/ic_menu_mylocation"
                app:drawableTint="@color/primary"
                android:drawablePadding="16dp"
                android:alpha="0.8"
                tools:text="Plot No 42, Green Park Road, North Sector, District 4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailNavigate"
                style="@style/Widget.CivSetu.Button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                android:text="@string/navigate_to_spot"
                android:textSize="16sp"
                app:icon="@android:drawable/ic_menu_directions"
                app:iconSize="24dp"
                app:iconTint="@color/white"/>

            <!-- Admin Actions Hub -->
            <LinearLayout
                android:id="@+id/layoutAdminActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="48dp"
                android:paddingBottom="48dp"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outlineVariant"
                    android:layout_marginBottom="32dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Official Command"
                    android:textAppearance="@style/TextAppearance.CivSetu.Label"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="24dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApproveDetail"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:text="@string/approve_assign"
                        android:textColor="@color/status_resolved"
                        app:icon="@android:drawable/checkbox_on_background"
                        app:iconTint="@color/status_resolved"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeclineDetail"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:text="@string/decline"
                        android:textColor="@color/error"
                        app:icon="@android:drawable/ic_menu_close_clear_cancel"
                        app:iconTint="@color/error"
                        app:cornerRadius="16dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResolveDetail"
                    style="@style/Widget.CivSetu.Button"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/resolve"
                    app:backgroundTint="@color/status_resolved"
                    app:icon="@android:drawable/ic_menu_save"
                    app:iconTint="@color/white"
                    android:visibility="gone"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
